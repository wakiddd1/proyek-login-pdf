<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Dokumen Anda</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="user-info-corner">
        <span>Selamat datang, <strong><%= username %></strong>!</span>
        <a href="/logout" class="logout-link">Logout</a>
    </div>
    <div class="pdf-container">
        <% if (pdfFile) { %>
            <iframe
                src="/pdfjs/web/viewer.html?file=/view-pdf/<%= pdfFile %>"
                width="100%"
                height="100%"
                style="border: none;">
            </iframe>
        <% } else { %>
            <div style="text-align: center; padding-top: 50px; color: #555;">
                <h2>Menuggu Respon</h2>
                <p>Belum ada dokumen yang ditampilkan untuk Anda. Silakan menghubungi IT.</p>
            </div>
        <% } %>
    </div>

</body>
</html>